# LastDance · public_html/.htaccess
Options -Indexes
RewriteEngine On
RewriteBase /

# A API e os ficheiros que existem são servidos tal como estão
RewriteRule ^api/ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todas as outras páginas (/entrar, /gestao, ...) são do site
RewriteRule ^ index.html [L]

# Cache: ficheiros com nome versionado podem ficar guardados muito tempo
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
